{
  "name": "luna",
  "version": "1.25.0-beta",
  "description": "A client mod for the Tidal music app for plugins",
  "author": {
    "name": "Inrixia",
    "url": "https://github.com/Inrixia"
  },
  "homepage": "https://github.com/Inrixia/TidaLuna",
  "repository": {
    "type": "git",
    "url": "https://github.com/Inrixia/TidaLuna.git"
  },
  "type": "module",
  "main": "./injector.mjs",
  "exports": {
    ".": {
      "types": "./luna.d.ts"
    },
    "./build": "./build/index.ts",
    "./buildPlugins": "./build/buildPlugins.ts",
    "./tsconfig.json": "./tsconfig.json"
  },
  "scripts": {
    "format": "prettier -wc ./src",
    "watch": "rimraf ./dist && tsx ./esbuild.config.ts --watch",
    "build": "rimraf ./dist && tsx ./esbuild.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "coverage:ci": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=coverage/test-results.json",
    "coverage:comment": "tsx test/coverageComment.ts",
    "coverage:thresholds": "tsx test/raiseCoverageThresholds.ts",
    "coverage:badge": "tsx test/coverageBadge.ts",
    "updateSkills": "node .agents/update-skills.mjs"
  },
  "agentSkills": {
    "source": "Inrixia/.claude",
    "ref": "main",
    "skills": [
      "code-design",
      "react",
      "review",
      "typescript",
      "vitest"
    ]
  },
  "license": "MS-Pl",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "5.1.1",
    "fake-indexeddb": "^6.2.8",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "redux": "^5.0.1",
    "rimraf": "^6.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@inrixia/helpers": "^3.22.0",
    "@types/clean-css": "^4.2.11",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^26.6.6",
    "clean-css": "^5.3.3",
    "esbuild": "^0.28.2",
    "html-minifier-terser": "^7.2.0",
    "semver": "7.8.6"
  }
}